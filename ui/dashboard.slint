import { ScrollView } from "std-widgets.slint";

// Bento Box 风格仪表盘：每张卡片纯色圆角，应用时长为柱状图。icon 放进结构体，切换时原地更新以便柱长做动画。
struct AppBar { name: string, dur: string, frac: float, icon: image }

// 时长格式化（秒 → 中文），用于数字滚动动画时实时格式化。
global Fmt {
    public pure function dur(sec: float) -> string {
        return sec >= 3600
            ? "\{Math.floor(sec / 3600)}小时\{Math.floor((sec - Math.floor(sec / 3600) * 3600) / 60)}分"
            : (sec >= 60 ? "\{Math.floor(sec / 60)}分" : "\{Math.floor(sec)}秒");
    }
}

// 软件渲染器下：纯色 + border-radius 才能可靠出圆角（渐变/阴影不被裁到圆角）。clip 保证内容不撑大卡片。
component Card inherits Rectangle {
    background: #FFFFFF;
    border-radius: 24px;
    clip: true;
}

// 历史视图的时间范围选择小胶囊。
component Chip inherits Rectangle {
    callback clicked();
    in property <string> label;
    in property <bool> active;
    height: 28px;
    border-radius: 14px;
    background: active ? #1D4ED8 : (ta.has-hover ? #E3E7EF : #FFFFFF);
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text { text: root.label; color: active ? #FFFFFF : #3A3A3F; font-size: 13px; vertical-alignment: center; }
    }
}

export component Dashboard inherits Window {
    in property <string> date;
    in property <int> active-sec;
    in property <int> idle-sec;
    in property <[AppBar]> appbars;
    in property <[string]> sites;
    in property <[string]> videos;
    in property <string> summary;
    in property <image> app_icon;
    in property <bool> history_mode;
    in property <int> active_range;
    in property <bool> refreshing;
    // 数字滚动：用 linear 让数字匀速逐格变化（ease-out 会把大部分变化压在开头，增大时看着像瞬间跳到位）。
    property <float> active-shown;
    property <float> idle-shown;
    animate active-shown { duration: 800ms; easing: linear; }
    animate idle-shown { duration: 800ms; easing: linear; }
    changed active-sec => { self.active-shown = self.active-sec; }
    changed idle-sec => { self.idle-shown = self.idle-sec; }
    callback close-clicked();
    callback start-drag();
    callback pick-range(int);
    title: "今天用啥";
    icon: app_icon;
    no-frame: true;
    background: transparent;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    // 固定窗口尺寸：无论今日/近7天/近30天/全部，窗口与各卡片大小都不变（配合固定行数/柱数 + Card clip）。
    width: 980px;
    height: 700px;

    Rectangle {
        width: 100%;
        height: 100%;
        background: #EEEFF2;
        border-radius: 24px;

        VerticalLayout {
            padding: 20px;
            spacing: 16px;

            Rectangle {
                height: 52px;
                drag := TouchArea {
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                            root.start-drag();
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Image { width: 44px; height: 44px; source: app_icon; image-fit: contain; image-rendering: smooth; }
                    Text { text: date; font-size: 22px; font-weight: 700; color: #1D1D1F; vertical-alignment: center; }
                    // 时间范围分段（就在日期旁边；切换不改布局，只换数字→丝滑）。垂直居中于标题栏。
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 6px;
                            Chip { label: "今日"; active: root.active_range == 0; clicked => { root.pick-range(0); } }
                            Chip { label: "近7天"; active: root.active_range == 1; clicked => { root.pick-range(1); } }
                            Chip { label: "近30天"; active: root.active_range == 2; clicked => { root.pick-range(2); } }
                            Chip { label: "全部"; active: root.active_range == 3; clicked => { root.pick-range(3); } }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 10px;
                        background: cta.has-hover ? #E23B3B : #0000001A;
                        cta := TouchArea {
                            clicked => {
                                root.close-clicked();
                            }
                        }
                        Text { text: "×"; color: cta.has-hover ? #FFFFFF : #2A2A2E; font-size: 26px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

        // 舞台：切换时间范围时，整块内容做 PPT 式横向平滑推移（clip 裁掉滑出的部分）。不用 opacity（软件渲染器 + 悬停局部重绘会出问题）。
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 16px;

        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 3;
            Card {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                background: #C4DBFF;
                VerticalLayout {
                    padding: 22px;
                    spacing: 8px;
                    Text { text: "有效时长"; color: #1D4ED8; font-size: 18px; font-weight: 700; }
                    Text {
                        text: Fmt.dur(root.active-shown);
                        color: #12245B; font-size: 40px; font-weight: 700;
                    }
                    Text {
                        text: "空闲 " + Fmt.dur(root.idle-shown);
                        color: #33477E; font-size: 14px;
                    }
                }
            }
            Card {
                horizontal-stretch: 2;
                min-width: 0px;
                preferred-width: 0px;
                background: #BEE9D1;
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    Text { text: "应用时长"; color: #15803D; font-size: 18px; font-weight: 700; }
                    for a[i] in appbars : HorizontalLayout {
                        height: 32px;
                        spacing: 10px;
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 7px;
                            background: a.name == "" ? #00000000 : #FFFFFFC0;
                            Image { width: 20px; height: 20px; source: a.icon; image-fit: contain; }
                        }
                        VerticalLayout {
                            spacing: 3px;
                            HorizontalLayout {
                                Text {
                                    text: a.name;
                                    color: root.refreshing ? #14361F00 : #14361F;
                                    animate color { duration: 180ms; }
                                    font-size: 13px;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: a.dur;
                                    color: root.refreshing ? #2F5B3F00 : #2F5B3F;
                                    animate color { duration: 180ms; }
                                    font-size: 12px;
                                }
                            }
                            Rectangle {
                                height: 7px;
                                border-radius: 3px;
                                background: #00000018;
                                Rectangle {
                                    x: 0;
                                    y: 0;
                                    height: 7px;
                                    border-radius: 3px;
                                    // 柱长平滑伸缩（切换时间范围时 morph）
                                    width: parent.width * a.frac;
                                    animate width { duration: 550ms; easing: ease-out; }
                                    background: #15803D;
                                }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 2;
            Card {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                background: #DFCDFB;
                VerticalLayout {
                    padding: 20px;
                    spacing: 6px;
                    Text { text: "Top 网站"; color: #6D28D9; font-size: 18px; font-weight: 700; }
                    // 固定 5 行（不足补空行），保证有无数据时卡片外观一致
                    for s in sites : Rectangle {
                        height: 22px;
                        Text { width: 100%; text: s; color: root.refreshing ? #2E1A5400 : #2E1A54; animate color { duration: 180ms; } font-size: 13px; vertical-alignment: center; overflow: elide; }
                    }
                }
            }
            Card {
                horizontal-stretch: 2;
                min-width: 0px;
                preferred-width: 0px;
                background: #FBD3B0;
                VerticalLayout {
                    padding: 20px;
                    spacing: 6px;
                    Text { text: "Top 视频"; color: #C2410C; font-size: 18px; font-weight: 700; }
                    for v in videos : Rectangle {
                        height: 22px;
                        Text { width: 100%; text: v; color: root.refreshing ? #5A2A1100 : #5A2A11; animate color { duration: 180ms; } font-size: 13px; vertical-alignment: center; overflow: elide; }
                    }
                }
            }
        }

        Card {
            height: 110px;
            background: #CBE8EC;
            VerticalLayout {
                padding: 18px;
                spacing: 6px;
                Text { text: "AI 总结"; color: #0E7490; font-size: 18px; font-weight: 700; }
                ScrollView {
                    Text {
                        width: parent.visible-width;
                        text: summary;
                        color: root.refreshing ? #123C4400 : #123C44;
                        animate color { duration: 180ms; }
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                }
            }
        }
            } // 舞台内容 VerticalLayout 结束
        } // 舞台 Rectangle 结束
    }
    }
}

component MenuRow inherits Rectangle {
    callback clicked();
    in property <string> label;
    in property <color> dot;
    height: 34px;
    border-radius: 9px;
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    background: ta.has-hover ? #EDEFF3 : transparent;
    Rectangle {
        x: 14px;
        y: root.height / 2 - 4px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.dot;
    }
    Text {
        x: 34px;
        width: root.width - 46px;
        height: root.height;
        text: root.label;
        color: #1D1D1F;
        font-size: 14px;
        vertical-alignment: center;
    }
}

export component TrayMenu inherits Window {
    callback act(int);
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: 160px;
    height: 90px;
    Rectangle {
        background: #FFFFFF;
        border-radius: 14px;
        drop-shadow-blur: 22px;
        drop-shadow-color: #00000033;
        drop-shadow-offset-y: 6px;
        VerticalLayout {
            padding: 8px;
            spacing: 2px;
            MenuRow {
                label: "查看今日统计";
                dot: #2563EB;
                clicked => {
                    root.act(0);
                }
            }
            MenuRow {
                label: "退出";
                dot: #EF4444;
                clicked => {
                    root.act(1);
                }
            }
        }
    }
}
