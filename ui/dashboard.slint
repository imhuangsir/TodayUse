// Bento Box 风格仪表盘：每张卡片都有配色（中等饱和渐变），应用时长为柱状图。
struct AppBar { name: string, dur: string, frac: float }

// 软件渲染器下：纯色 + border-radius 才能可靠出圆角（渐变/阴影不被裁到圆角）。
component Card inherits Rectangle {
    background: #FFFFFF;
    border-radius: 24px;
}

export component Dashboard inherits Window {
    in property <string> date;
    in property <string> active;
    in property <string> idle;
    in property <[AppBar]> appbars;
    in property <[image]> icons;
    in property <[string]> sites;
    in property <[string]> videos;
    in property <string> summary;
    in property <image> app_icon;
    callback close-clicked();
    callback start-drag();
    title: "今天用啥";
    icon: app_icon;
    no-frame: true;
    background: transparent;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    preferred-width: 980px;
    preferred-height: 640px;

    Rectangle {
        background: #EEEFF2;
        border-radius: 24px;

        VerticalLayout {
            padding: 20px;
            spacing: 16px;

            Rectangle {
                height: 52px;
                drag := TouchArea {
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                            root.start-drag();
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Image { width: 44px; height: 44px; source: app_icon; image-fit: contain; image-rendering: smooth; }
                    Text { text: "今天用啥 · " + date; font-size: 24px; font-weight: 700; color: #1D1D1F; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 10px;
                        background: cta.has-hover ? #E23B3B : #0000001A;
                        cta := TouchArea {
                            clicked => {
                                root.close-clicked();
                            }
                        }
                        Text { text: "×"; color: cta.has-hover ? #FFFFFF : #2A2A2E; font-size: 26px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 1;
            Card {
                horizontal-stretch: 1;
                background: #C4DBFF;
                VerticalLayout {
                    padding: 22px;
                    spacing: 8px;
                    Text { text: "有效时长"; color: #1D4ED8; font-size: 18px; font-weight: 700; }
                    Text { text: active; color: #12245B; font-size: 40px; font-weight: 700; }
                    Text { text: "空闲 " + idle; color: #33477E; font-size: 14px; }
                }
            }
            Card {
                horizontal-stretch: 2;
                background: #BEE9D1;
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    Text { text: "应用时长"; color: #15803D; font-size: 18px; font-weight: 700; }
                    for a[i] in appbars : HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 7px;
                            background: #FFFFFFC0;
                            Image { width: 20px; height: 20px; source: icons[i]; image-fit: contain; }
                        }
                        VerticalLayout {
                            spacing: 3px;
                            HorizontalLayout {
                                Text { text: a.name; color: #14361F; font-size: 13px; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: a.dur; color: #2F5B3F; font-size: 12px; }
                            }
                            Rectangle {
                                height: 7px;
                                border-radius: 3px;
                                background: #00000018;
                                Rectangle {
                                    x: 0;
                                    y: 0;
                                    height: 7px;
                                    border-radius: 3px;
                                    width: parent.width * a.frac;
                                    background: #15803D;
                                }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 1;
            Card {
                horizontal-stretch: 1;
                background: #DFCDFB;
                VerticalLayout {
                    padding: 20px;
                    spacing: 6px;
                    Text { text: "Top 网站"; color: #6D28D9; font-size: 18px; font-weight: 700; }
                    for s in sites : Text { text: s; color: #2E1A54; font-size: 14px; }
                }
            }
            Card {
                horizontal-stretch: 1;
                background: #FBD3B0;
                VerticalLayout {
                    padding: 20px;
                    spacing: 6px;
                    Text { text: "Top 视频"; color: #C2410C; font-size: 18px; font-weight: 700; }
                    for v in videos : Text { text: v; color: #5A2A11; font-size: 14px; }
                }
            }
        }

        Card {
            height: 120px;
            background: #CBE8EC;
            VerticalLayout {
                padding: 18px;
                spacing: 6px;
                Text { text: "AI 总结"; color: #0E7490; font-size: 18px; font-weight: 700; }
                Text { text: summary; color: #123C44; font-size: 13px; wrap: word-wrap; }
            }
        }
    }
    }
}

component MenuRow inherits Rectangle {
    callback clicked();
    in property <string> label;
    in property <color> dot;
    height: 34px;
    border-radius: 9px;
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    background: ta.has-hover ? #EDEFF3 : transparent;
    Rectangle {
        x: 14px;
        y: root.height / 2 - 4px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.dot;
    }
    Text {
        x: 34px;
        width: root.width - 46px;
        height: root.height;
        text: root.label;
        color: #1D1D1F;
        font-size: 14px;
        vertical-alignment: center;
    }
}

export component TrayMenu inherits Window {
    callback act(int);
    in property <string> toggle_text: "暂停记录";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: 160px;
    height: 162px;
    Rectangle {
        background: #FFFFFF;
        border-radius: 14px;
        drop-shadow-blur: 22px;
        drop-shadow-color: #00000033;
        drop-shadow-offset-y: 6px;
        VerticalLayout {
            padding: 8px;
            spacing: 2px;
            MenuRow {
                label: "查看今日统计";
                dot: #2563EB;
                clicked => {
                    root.act(0);
                }
            }
            MenuRow {
                label: root.toggle_text;
                dot: #16A34A;
                clicked => {
                    root.act(1);
                }
            }
            MenuRow {
                label: "立即生成总结";
                dot: #7C3AED;
                clicked => {
                    root.act(2);
                }
            }
            MenuRow {
                label: "退出";
                dot: #EF4444;
                clicked => {
                    root.act(3);
                }
            }
        }
    }
}
